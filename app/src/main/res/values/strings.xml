<resources>
    <string name="app_name">magpie usage</string>

    <string name="address_title">连接 magpie</string>
    <string name="address_description">输入网页控制面板地址。可填写不带 key 的地址，也可以粘贴包含 ?k= 的完整登录链接。</string>
    <string name="address_hint">http://192.168.31.60:3430</string>
